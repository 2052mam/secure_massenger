# Database and application secrets
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost/secure_messenger
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=replace-this-admin-password
ADMIN_SECRET_PATH=sm-admin-x9k2p7
UPLOAD_FOLDER=uploads

# Phone verification delivery
# Production: sms_ir. Local manual testing: console (prints OTP only to the
# backend log; it is never sent back in an API response).
SMS_DELIVERY_MODE=sms_ir
SMS_IR_API_KEY=replace-with-your-sms-ir-api-key
SMS_IR_TEMPLATE_ID=replace-with-your-numeric-template-id
# Use the exact parameter names created in SMS.ir. The default sends one CODE
# parameter. For a two-parameter template, uncomment and adapt this JSON:
SMS_IR_CODE_PARAMETER=CODE
# SMS_IR_TEMPLATE_PARAMETERS={"CODE":"{code}","APP":"SecureMessenger"}
SMS_IR_TIMEOUT_SECONDS=10

# Server-side OTP controls. Do not lower these values in production.
PHONE_CODE_TTL_SECONDS=600
PHONE_CODE_RESEND_SECONDS=60
PHONE_CODE_MAX_ATTEMPTS=5
PHONE_CODE_MAX_PER_HOUR=5
PHONE_CODE_MAX_PER_IP_HOUR=20
